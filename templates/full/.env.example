# Database
DATABASE_URL="postgresql://my_app_user:my_app_password@localhost:5432/my_app_db"

# API
NODE_ENV="development"
PORT=4202
CORS_ORIGIN="http://localhost:4200,http://localhost:4201"

# JWT — change both secrets in production
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="change-me-refresh-in-production"
JWT_REFRESH_EXPIRES_IN="30d"

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:4202"
VITE_API_URL="http://localhost:4202"

# Stripe — uncomment when adding payments
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Resend — uncomment when adding transactional email
# RESEND_API_KEY=
