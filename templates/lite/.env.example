# Supabase — required. Get these from your project's Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Stripe — uncomment when adding payments.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Resend — uncomment when adding transactional email.
# RESEND_API_KEY=

# PostHog — uncomment when adding product analytics.
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Sentry — uncomment when adding error tracking.
# NEXT_PUBLIC_SENTRY_DSN=
